+  );
+};
+
+export const plugin = new PanelPlugin<LogFilterOptions>(LogFilterPanel).setPanelOptions((builder) =>
+  builder
+    .addBooleanSwitch({
+      path: 'showLogsqlTextarea',
+      name: 'Show logsql textarea',
